{{- $machine := includeTemplate "machine" . | fromJson -}}
#!/usr/bin/env bash
set -euo pipefail

{{- if eq $machine.os "linux" }}
if command -v zsh >/dev/null 2>&1 && [[ "${SHELL##*/}" != "zsh" ]]; then
  chsh -s "$(command -v zsh)" || echo "Set zsh manually with: chsh -s $(command -v zsh)"
fi
{{- end }}
