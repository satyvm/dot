{{- $machine := includeTemplate "machine" . | fromJson -}}
{{- $devRoot := $machine.devRoot -}}
# Managed by chezmoi. Gateway settings are injected by ax for that launch only.

[history]
persistence = "save-all"

{{- $servers := .aiTools.mcp.servers -}}
{{- range $name := keys $servers | sortAlpha }}
{{- $server := index $servers $name }}
[mcp_servers.{{ $name }}]
command = {{ $server.command | quote }}
args = [{{ range $i, $arg := $server.args }}{{ if $i }}, {{ end }}{{ if eq $arg "$DEV_ROOT" }}{{ $devRoot | quote }}{{ else }}{{ $arg | quote }}{{ end }}{{ end }}]
{{ end -}}
