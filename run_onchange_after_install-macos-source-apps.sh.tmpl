{{- $machine := includeTemplate "machine" . | fromJson -}}
{{- if and (eq $machine.os "darwin") (eq $machine.features.guiTier "all") $machine.predicates.manageHostPackages -}}
#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.cargo/bin:{{ $machine.homebrewPrefix }}/bin:$PATH"

if ! xcode-select -p >/dev/null 2>&1; then
  printf 'Xcode Command Line Tools are required to build macOS source apps. Run xcode-select --install, then retry chezmoi apply.\n' >&2
  exit 1
fi
for tool in git make scdoc tic codesign ditto plutil; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    printf '%s is required to build macOS source apps; rerun the Homebrew package installer first.\n' "$tool" >&2
    exit 1
  fi
done

if ! command -v rustup >/dev/null 2>&1; then
  curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs |
    sh -s -- -y --default-toolchain {{ .packages.runtimePins.rustToolchain | quote }}
fi
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"
rustup toolchain install {{ .packages.runtimePins.rustToolchain | quote }}

build_root="$(mktemp -d "${TMPDIR:-/tmp}/dot-macos-source-apps.XXXXXX")"
trap 'rm -rf "$build_root"' EXIT
mkdir -p "$HOME/Applications"

install_source_app() {
  local name="$1" url="$2" version="$3" commit="$4" target="$5" artifact="$6" app="$7"
  local destination="$HOME/Applications/$app"
  local installed_version=""
  if [[ -f "$destination/Contents/Info.plist" ]]; then
    installed_version="$(plutil -extract CFBundleShortVersionString raw "$destination/Contents/Info.plist" 2>/dev/null || true)"
  fi
  if [[ "$installed_version" == "$version" ]]; then
    printf '%s %s is already installed.\n' "$name" "$version"
    return 0
  fi

  local worktree="$build_root/$name"
  git clone --depth 1 --branch "v$version" "$url" "$worktree"
  if [[ "$(git -C "$worktree" rev-parse HEAD)" != "$commit" ]]; then
    printf '%s source tag does not match the pinned commit.\n' "$name" >&2
    return 1
  fi
  RUSTUP_TOOLCHAIN={{ .packages.runtimePins.rustToolchain | quote }} make -C "$worktree" "$target"
  if [[ ! -d "$worktree/$artifact" ]]; then
    printf '%s build did not produce %s.\n' "$name" "$artifact" >&2
    return 1
  fi
  ditto "$worktree/$artifact" "$destination"
  printf '%s %s installed at %s.\n' "$name" "$version" "$destination"
}

{{- range $pkg := .packages.inventory }}
  {{- $provider := index (index $pkg "providers" | default dict) "sourceApp" | default dict }}
  {{- $oses := index $pkg "os" | default (list "darwin" "linux") }}
  {{- $arches := index $pkg "arch" | default (list "amd64" "arm64") }}
  {{- if and (eq $pkg.feature "gui-all") (has "darwin" $oses) (has $machine.arch $arches) (ne (len $provider) 0) }}
install_source_app {{ $pkg.id | quote }} {{ $provider.url | quote }} {{ $provider.version | quote }} {{ $provider.commit | quote }} {{ $provider.target | quote }} {{ $provider.artifact | quote }} {{ $provider.app | quote }}
  {{- end }}
{{- end }}
{{- end }}
