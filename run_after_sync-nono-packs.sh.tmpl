{{- $machine := includeTemplate "machine" . | fromJson -}}
{{- if $machine.features.ai -}}
#!/usr/bin/env bash
set -euo pipefail

warn() { printf 'warning: %s\n' "$*" >&2; }

if ! command -v nono >/dev/null 2>&1; then
  printf 'nono is required before agent packs can be synchronized.\n' >&2
  exit 1
fi

# Pack namespace policy: nolabs-ai. The always-further org was renamed to
# nolabs-ai upstream (github.com/always-further/nono now redirects there), and
# the packs left behind under the old name are stale: nono 0.77.0 rejects them
# with `unknown field \`undo\``, so every ax launch for that agent would fail.
# Verified by pulling each one with nono 0.77.0 inside the t3 image.
# Crush has no published pack in either namespace and uses default-agent.
required_packs=(
  nolabs-ai/codex
  nolabs-ai/claude
  nolabs-ai/omp
  nolabs-ai/opencode
)

# Packs retired upstream. Leaving a stale copy installed shadows the live one.
retired_packs=(
  always-further/claude
  always-further/pi
  always-further/opencode
  nolabs-ai/pi
)

installed_packs="$(nono list --installed)"

for pack in "${required_packs[@]}"; do
  if grep -qF "${pack}"$'\t' <<<"$installed_packs"; then
    nono update "$pack" --silent || warn "Could not update $pack; keeping the installed version"
  else
    nono pull "$pack" --silent || warn "Could not pull $pack; ax launches for that agent will fail"
  fi
done

for pack in "${retired_packs[@]}"; do
  if grep -qF "${pack}"$'\t' <<<"$installed_packs"; then
    nono remove "$pack" --silent || warn "Could not remove retired pack $pack"
  fi
done
{{- end }}
