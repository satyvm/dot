{{- $machine := includeTemplate "machine" . | fromJson -}}
{{- if and $machine.features.ai $machine.predicates.manageHostPackages -}}
#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$PATH"

tool_is_healthy() {
  command -v "$1" >/dev/null 2>&1 && "$1" --version >/dev/null 2>&1
}

install_from_script() {
  local command_name="$1" url="$2"
  shift 2
  if tool_is_healthy "$command_name"; then
    return 0
  fi
  local installer
  installer="$(mktemp "${TMPDIR:-/tmp}/dot-install.XXXXXX")"
  trap 'rm -f "$installer"' RETURN
  curl --proto '=https' --tlsv1.2 -fsSL "$url" -o "$installer"
  bash "$installer" "$@"
  tool_is_healthy "$command_name" || {
    printf 'Installer completed but %s cannot start from PATH.\n' "$command_name" >&2
    return 1
  }
}

{{- range $pkg := .packages.inventory }}
  {{- $provider := index (index $pkg "providers" | default dict) "installScript" | default dict }}
  {{- if and (eq $pkg.feature "ai") (ne (len $provider) 0) }}
install_from_script {{ $provider.command | quote }} {{ $provider.url | quote }}{{ range $provider.args }} {{ . | quote }}{{ end }}
  {{- end }}
{{- end }}
{{- end }}
