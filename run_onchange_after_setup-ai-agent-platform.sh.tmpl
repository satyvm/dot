{{- $machine := includeTemplate "machine" . | fromJson -}}
#!/usr/bin/env bash
set -euo pipefail

warn() { printf 'warning: %s\n' "$*" >&2; }

# Claude Code keeps user-scoped MCPs in ~/.claude.json alongside mutable
# session state. Merge only the catalog-owned server names and preserve every
# other key rather than managing that whole file with chezmoi.
managed_mcp="$HOME/.config/ai-tools/claude-mcp.json"
claude_config="$HOME/.claude.json"
if command -v jq >/dev/null 2>&1 && [[ -s "$managed_mcp" ]]; then
  claude_tmp="$(mktemp "${TMPDIR:-/tmp}/claude-mcp.XXXXXX")"
  if [[ -s "$claude_config" ]]; then
    jq --slurpfile managed "$managed_mcp" \
      '.mcpServers = ((.mcpServers // {}) + $managed[0].mcpServers)' \
      "$claude_config" >"$claude_tmp"
  else
    jq '.' "$managed_mcp" >"$claude_tmp"
  fi
  install -m 0600 "$claude_tmp" "$claude_config"
  rm -f "$claude_tmp"
else
  warn "jq or the managed MCP catalog is missing; Claude MCP sync was skipped"
fi

# Hermes keeps MCP definitions and provider settings in the same mutable YAML document.
# Merge mcp_servers and sync provider/model config with Hermes' Python/YAML runtime.
{{- $proxyUrl := "http://127.0.0.1:8317/v1" }}
{{- if eq $machine.features.aiMode "remote" }}
{{- $proxyUrl = "http://cliproxyapi:8317/v1" }}
{{- end }}
{{- $managedModels := merge (deepCopy .aiAgentPlatform.roles) (deepCopy .aiAgentPlatform.catalog) }}
hermes_python="${HERMES_WEBUI_PYTHON:-python3}"
hermes_config="$HOME/.hermes/config.yaml"
if command -v hermes >/dev/null 2>&1 && \
   "$hermes_python" -c 'import yaml' >/dev/null 2>&1 && \
   [[ -s "$managed_mcp" ]]; then
  HERMES_MANAGED_MCP="$managed_mcp" HERMES_CONFIG="$hermes_config" HERMES_PROXY_URL="{{ $proxyUrl }}" \
    "$hermes_python" - <<'PY'
import json
import os
from pathlib import Path
import tempfile

import yaml

managed_path = Path(os.environ["HERMES_MANAGED_MCP"])
config_path = Path(os.environ["HERMES_CONFIG"])
proxy_url = os.environ.get("HERMES_PROXY_URL", "http://127.0.0.1:8317/v1")
managed = json.loads(managed_path.read_text())["mcpServers"]
servers = {
    name: {
        key: value
        for key, value in definition.items()
        if key in {"command", "args", "env", "url", "headers"}
    }
    for name, definition in managed.items()
}

config = {}
if config_path.exists():
    config = yaml.safe_load(config_path.read_text()) or {}
if not isinstance(config, dict):
    raise SystemExit(f"{config_path} must contain a YAML mapping")
config["mcp_servers"] = servers

provider_name = "CLIProxyAPI"
provider_id = "custom:cliproxyapi"

model_config = config.get("model", {})
if not isinstance(model_config, dict):
    model_config = {}
model_config.update({
    "default": "balanced",
    "provider": provider_id,
    "base_url": proxy_url,
    "api_mode": "chat_completions",
})
model_config.pop("model", None)
config["model"] = model_config
config.pop("provider", None)
config["fallback_providers"] = [
    {
        "provider": "custom",
        "model": "gemini-3-flash-agent",
        "base_url": proxy_url,
        "key_env": "OPENAI_API_KEY",
    },
    {
        "provider": "custom",
        "model": "gpt-5.6-luna",
        "base_url": proxy_url,
        "key_env": "OPENAI_API_KEY",
    },
]

model_aliases = config.get("model_aliases", {})
if not isinstance(model_aliases, dict):
    model_aliases = {}

canonical_aliases = {}
{{- $rawModels := merge (deepCopy .aiAgentPlatform.roles) (deepCopy .aiAgentPlatform.catalog) }}
{{- range $key, $model := $rawModels }}
{{- if $model.reasoningSuffix }}
{{- $suffix := printf "(%s)" $model.reasoningSuffix }}
canonical_aliases[{{ $key | quote }}] = {{ (printf "%s%s" $key $suffix) | quote }}
{{- if and $model.target (ne $model.target $key) }}
canonical_aliases[{{ $model.target | quote }}] = {{ (printf "%s%s" $model.target $suffix) | quote }}
{{- end }}
{{- else }}
canonical_aliases[{{ $key | quote }}] = {{ $key | quote }}
{{- if and $model.target (ne $model.target $key) }}
canonical_aliases[{{ $model.target | quote }}] = {{ $model.target | quote }}
{{- end }}
{{- end }}
{{- end }}
managed_aliases = set(canonical_aliases)
for alias_key in list(model_aliases):
    entry = model_aliases.get(alias_key)
    if isinstance(entry, dict) and entry.get("provider") == provider_id and alias_key not in managed_aliases:
        del model_aliases[alias_key]
for alias_key, model_name in canonical_aliases.items():
    model_aliases[alias_key] = {
        "model": model_name,
        "provider": provider_id,
        "base_url": proxy_url,
    }
config["model_aliases"] = model_aliases

custom_providers = config.get("custom_providers", [])
if not isinstance(custom_providers, list):
    custom_providers = []
custom_cfg = next(
    (
        entry
        for entry in custom_providers
        if isinstance(entry, dict)
        and (
            str(entry.get("name", "")).strip().lower() == provider_name.lower()
            or str(entry.get("base_url", "")).rstrip("/") == proxy_url.rstrip("/")
        )
    ),
    None,
)
if custom_cfg is None:
    custom_cfg = {}
    custom_providers.append(custom_cfg)
custom_cfg.update({
    "name": provider_name,
    "base_url": proxy_url,
    "key_env": "OPENAI_API_KEY",
    "api_mode": "chat_completions",
    "discover_models": True,
    "models": {
{{- $rawModels := merge (deepCopy .aiAgentPlatform.roles) (deepCopy .aiAgentPlatform.catalog) -}}
{{- $expanded := dict -}}
{{- range $key, $model := $rawModels -}}
  {{- $_ := set $expanded $key $model -}}
  {{- if $model.target -}}
    {{- $_ := set $expanded $model.target $model -}}
  {{- end -}}
  {{- if $model.reasoningSuffix -}}
    {{- $suffix := printf "(%s)" $model.reasoningSuffix -}}
    {{- $_ := set $expanded (printf "%s%s" $key $suffix) $model -}}
    {{- if $model.target -}}
      {{- $_ := set $expanded (printf "%s%s" $model.target $suffix) $model -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- range $modelID := keys $expanded | sortAlpha }}
{{- $model := index $expanded $modelID }}
        {{ $modelID | quote }}: {"context_length": {{ $model.contextWindow }}},
{{- end }}
    },
})
custom_cfg.pop("api_base", None)
custom_cfg.pop("api_key", None)
config["custom_providers"] = custom_providers

config_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
handle, temporary = tempfile.mkstemp(
    prefix=".config.", suffix=".yaml", dir=config_path.parent
)
try:
    with os.fdopen(handle, "w") as stream:
        yaml.safe_dump(config, stream, sort_keys=False)
    os.chmod(temporary, 0o600)
    os.replace(temporary, config_path)
finally:
    if os.path.exists(temporary):
        os.unlink(temporary)

env_path = config_path.parent / ".env"
env_lines = []
if env_path.exists():
    env_lines = env_path.read_text().splitlines()
env_dict = {}
for line in env_lines:
    if "=" in line and not line.strip().startswith("#"):
        k, v = line.split("=", 1)
        env_dict[k.strip()] = v.strip()

env_dict["OPENAI_API_BASE"] = proxy_url
env_dict["OPENAI_BASE_URL"] = proxy_url
if os.environ.get("OPENAI_API_KEY"):
    env_dict["OPENAI_API_KEY"] = os.environ["OPENAI_API_KEY"]

new_env = "\n".join(f"{k}={v}" for k, v in env_dict.items()) + "\n"
env_path.write_text(new_env)
os.chmod(env_path, 0o600)
PY
elif command -v hermes >/dev/null 2>&1; then
  warn "Hermes Python/YAML runtime is unavailable; Hermes MCP sync was skipped"
fi

if command -v herdr >/dev/null 2>&1; then
  for agent in claude pi opencode; do
    if command -v "$agent" >/dev/null 2>&1; then
      if [[ "$agent" == "pi" ]]; then
        PI_CODING_AGENT_DIR="$HOME/.pi/agent" herdr integration install "$agent" || warn "Could not install Herdr integration for $agent"
      else
        herdr integration install "$agent" || warn "Could not install Herdr integration for $agent"
      fi
    fi
  done
else
  warn "Herdr is missing; agent integrations were skipped"
fi

{{- if eq $machine.features.aiMode "local" }}
if ! command -v brew >/dev/null 2>&1; then
  warn "Homebrew is missing; local CLIProxyAPI service setup was skipped"
  exit 0
fi

proxy_config="$HOME/.config/cli-proxy-api/config.yaml"
brew_proxy_config="$(brew --prefix)/etc/cliproxyapi.conf"
if [[ -f "$proxy_config" ]]; then
  mkdir -p "$(dirname "$brew_proxy_config")"
  ln -sfn "$proxy_config" "$brew_proxy_config"
else
  warn "CLIProxyAPI config is missing; run chezmoi apply"
fi

if [[ -s "$HOME/.config/cli-proxy-api/client-key" ]]; then
  brew services restart cliproxyapi || warn "CLIProxyAPI did not start; retry brew services restart cliproxyapi"
else
  warn "CLIProxyAPI device keys are not initialized; run ax auth setup"
fi
{{- end }}
