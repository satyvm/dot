{{- $machine := includeTemplate "machine" . | fromJson -}}
{{- $devRoot := $machine.devRoot -}}
{
  "ssh_connections": [
    {
      "host": "t3-dev",
      "nickname": "T3 Dev",
      "projects": [{ "paths": ["/home/ubuntu/dev"] }],
      "upload_binary_over_ssh": true
    }
  ],
  "context_servers": {
{{- $servers := .aiTools.mcp.servers -}}
{{- range $index, $name := keys $servers | sortAlpha }}
{{- $server := index $servers $name }}
    "{{ $name }}": {
      "command": "{{ $server.command }}",
      "args": [{{ range $argIndex, $arg := $server.args }}{{ if $argIndex }}, {{ end }}{{ if eq $arg "$DEV_ROOT" }}{{ $devRoot | quote }}{{ else }}{{ $arg | quote }}{{ end }}{{ end }}]
    }{{ if lt $index (sub (len $servers) 1) }},{{ end }}
{{- end }}
  }
}
