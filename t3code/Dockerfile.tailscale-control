FROM python:3.11-alpine

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY tailscale_sidecar.py /usr/local/bin/tailscale-control
COPY t3_share_cli.py /usr/local/bin/t3-share
RUN chmod 0555 /usr/local/bin/tailscale-control /usr/local/bin/t3-share

ENTRYPOINT ["python3", "/usr/local/bin/tailscale-control"]
