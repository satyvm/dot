{{- $clientKeyPath := joinPath .chezmoi.homeDir ".config/cli-proxy-api/client-key" -}}
{{- $managementKeyHashPath := joinPath .chezmoi.homeDir ".config/cli-proxy-api/management-key.bcrypt" -}}
host: "127.0.0.1"
port: 8317
tls:
  enable: false
  cert: ""
  key: ""
remote-management:
  allow-remote: false
  secret-key: {{ if stat $managementKeyHashPath }}{{ include $managementKeyHashPath | trim | quote }}{{ else }}""{{ end }}
  disable-control-panel: false
auth-dir: "~/.config/cli-proxy-api"
api-keys:{{ if stat $clientKeyPath }}
  - {{ include $clientKeyPath | trim | quote }}{{ else }} []{{ end }}
debug: false
pprof:
  enable: false
  addr: "127.0.0.1:8316"
logging-to-file: true
logs-max-total-size-mb: 100
usage-statistics-enabled: false
force-model-prefix: false
request-retry: 5
max-retry-credentials: 3
max-retry-interval: 60
quota-exceeded:
  switch-project: true
  switch-preview-model: true
  antigravity-credits: false
routing:
  strategy: "round-robin"
  session-affinity: true
  session-affinity-ttl: "24h"
ws-auth: true
oauth-model-alias:
{{- $aliases := dict -}}
{{- $models := .aiAgentPlatform.roles -}}
{{- range $modelID := keys $models | sortAlpha }}
  {{- $model := index $models $modelID -}}
  {{- $existing := default (list) (get $aliases $model.provider) -}}
  {{- $_ := set $aliases $model.provider (append $existing $model) -}}
{{- end }}
{{- range $provider := keys $aliases | sortAlpha }}
  {{ $provider }}:
{{- range $model := get $aliases $provider }}
    - name: {{ $model.target | quote }}
      alias: {{ $model.alias | quote }}
      display-name: {{ $model.displayName | quote }}
      fork: true
      force-mapping: true
{{- end }}
{{- end }}
