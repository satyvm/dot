{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "instructions": [
    "{{ .chezmoi.homeDir }}/.config/agents/universal_context.md"
  ],
  "enabled_providers": ["cliproxy"],
  "model": "cliproxy/{{ .aiAgentPlatform.agents.opencode.defaultRole }}",
  "small_model": "cliproxy/light",
  "mcp": {
{{- $environment := "mac-dev" -}}
{{- if eq .aiMode "remote" }}{{ $environment = "remote-dev" }}{{ end -}}
{{- $devRoot := index .aiTools.paths.devRoot $environment -}}
{{- $servers := .aiTools.mcp.servers -}}
{{- range $index, $name := keys $servers | sortAlpha }}
{{- $server := index $servers $name }}
    "{{ $name }}": {
      "type": "local",
      "command": [{{ $server.command | quote }}{{ range $arg := $server.args }}, {{ if eq $arg "$DEV_ROOT" }}{{ $devRoot | quote }}{{ else }}{{ $arg | quote }}{{ end }}{{ end }}],
      "enabled": true
    }{{ if lt $index (sub (len $servers) 1) }},{{ end }}
{{- end }}
  },
  "lsp": {
{{- $lspServers := .aiTools.lsp.servers -}}
{{- range $index, $name := keys $lspServers | sortAlpha }}
{{- $server := index $lspServers $name }}
    "{{ $name }}": {
      "command": [{{ $server.command | quote }}{{ range $arg := $server.args }}, {{ $arg | quote }}{{ end }}],
      "extensions": {{ $server.extensions | toJson }}
    }{{ if lt $index (sub (len $lspServers) 1) }},{{ end }}
{{- end }}
  },
  "provider": {
    "cliproxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CLIProxyAPI",
      "options": {
        "baseURL": "{{ if eq .aiMode "remote" }}http://cliproxyapi:8317{{ else }}{{ .aiAgentPlatform.proxy.url }}{{ end }}/v1",
        "apiKey": "{env:OPENAI_API_KEY}",
        "timeout": 600000,
        "chunkTimeout": 60000
      },
      "models": {
{{- $rawModels := merge (deepCopy .aiAgentPlatform.roles) (deepCopy .aiAgentPlatform.catalog) -}}
{{- $expanded := dict -}}
{{- range $key, $model := $rawModels -}}
  {{- $_ := set $expanded $key $model -}}
  {{- if $model.target -}}
    {{- $_ := set $expanded $model.target $model -}}
  {{- end -}}
  {{- if $model.reasoningSuffix -}}
    {{- $suffix := printf "(%s)" $model.reasoningSuffix -}}
    {{- $_ := set $expanded (printf "%s%s" $key $suffix) $model -}}
    {{- if $model.target -}}
      {{- $_ := set $expanded (printf "%s%s" $model.target $suffix) $model -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $modelKeys := keys $expanded | sortAlpha -}}
{{- range $index, $modelID := $modelKeys }}
{{- $model := index $expanded $modelID }}
        "{{ $modelID }}": {
          "id": "{{ $modelID }}",
          "name": "{{ $model.displayName }} ({{ $modelID }})",
          "family": "managed",
          "limit": {
            "context": {{ $model.contextWindow }},
            "output": {{ $model.maxTokens }}
          },
          "modalities": {
            "input": {{ $model.input | toJson }},
            "output": ["text"]
          },
          "reasoning": {{ $model.reasoning }}
        }{{ if lt $index (sub (len $modelKeys) 1) }},{{ end }}
{{- end }}
      }
    }
  }
}
