{{- $machine := includeTemplate "machine" . | fromJson -}}
{
  "$schema": "https://charm.land/crush.json",
  "options": {
    "context_paths": [
      "{{ .chezmoi.homeDir }}/.config/agents/universal_context.md"
    ]
  },
  "mcp": {
{{- $devRoot := $machine.devRoot -}}
{{- $mcpServers := .aiTools.mcp.servers -}}
{{- range $index, $name := keys $mcpServers | sortAlpha }}
{{- $server := index $mcpServers $name }}
    "{{ $name }}": {
      "type": "stdio",
      "command": "{{ $server.command }}",
      "args": [{{ range $argIndex, $arg := $server.args }}{{ if $argIndex }}, {{ end }}{{ if eq $arg "$DEV_ROOT" }}{{ $devRoot | quote }}{{ else }}{{ $arg | quote }}{{ end }}{{ end }}],
      "timeout": 120,
      "disabled": false
    }{{ if lt $index (sub (len $mcpServers) 1) }},{{ end }}
{{- end }}
  },
  "lsp": {
{{- $lspServers := .aiTools.lsp.servers -}}
{{- range $index, $name := keys $lspServers | sortAlpha }}
{{- $server := index $lspServers $name }}
    "{{ $name }}": {
      "command": "{{ $server.command }}",
      "args": {{ $server.args | toJson }}
    }{{ if lt $index (sub (len $lspServers) 1) }},{{ end }}
{{- end }}
  },
  "providers": {
    "cliproxy": {
      "type": "openai-compat",
      "base_url": "{{ if eq $machine.features.aiMode "remote" }}http://cliproxyapi:8317{{ else }}{{ .aiAgentPlatform.proxy.url }}{{ end }}/v1",
      "api_key": "$OPENAI_API_KEY",
      "discover_models": true,
      "models": [
{{- $rawModels := merge (deepCopy .aiAgentPlatform.roles) (deepCopy .aiAgentPlatform.catalog) -}}
{{- $expanded := dict -}}
{{- range $key, $model := $rawModels -}}
  {{- $_ := set $expanded $key $model -}}
  {{- if $model.target -}}
    {{- $_ := set $expanded $model.target $model -}}
  {{- end -}}
  {{- if $model.reasoningSuffix -}}
    {{- $suffix := printf "(%s)" $model.reasoningSuffix -}}
    {{- $_ := set $expanded (printf "%s%s" $key $suffix) $model -}}
    {{- if $model.target -}}
      {{- $_ := set $expanded (printf "%s%s" $model.target $suffix) $model -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $modelKeys := keys $expanded | sortAlpha -}}
{{- range $index, $modelID := $modelKeys -}}
{{- $model := index $expanded $modelID }}
        {
          "id": "{{ $modelID }}",
          "name": "{{ $model.displayName }} ({{ $modelID }})",
          "context_window": {{ $model.contextWindow }},
          "default_max_tokens": {{ $model.maxTokens }}
        }{{ if lt $index (sub (len $modelKeys) 1) }},{{ end }}
{{- end }}
      ]
    }
  },
  "models": {
    "large": {
      "model": "{{ .aiAgentPlatform.classes.crush.large }}",
      "provider": "cliproxy",
      "max_tokens": {{ (index .aiAgentPlatform.roles .aiAgentPlatform.classes.crush.large).maxTokens }}
    },
    "small": {
      "model": "{{ .aiAgentPlatform.classes.crush.small }}",
      "provider": "cliproxy"
    }
  }
}
