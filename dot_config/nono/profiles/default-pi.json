{
  "meta": {
    "name": "default-pi",
    "version": "2.1.0",
    "description": "Thin ax overlay for the official Pi nono pack"
  },
  "extends": "always-further/pi",
  "security": {
    "signal_mode": "isolated",
    "capability_elevation": false
  },
  "groups": {
    "include": [
      "mise_manager",
      "bun_runtime",
      "go_runtime",
      {
        "name": "go_runtime_macos",
        "when": "macos"
      }
    ]
  },
  "filesystem": {
    "allow": [
      "$HOME/.npm/_cacache",
      "$HOME/.npm/_npx",
      "$HOME/.npm/_logs"
    ],
    "read": [
      "$HOME/.config/agents/skills",
      "$HOME/.local/state/fnm_multishells",
      "$HOME/.go"
    ],
    "read_file": [
      "$HOME/.config/agents/universal_context.md"
    ]
  },
  "network": {
    "block": false,
    "open_port": [8317],
    "no_proxy": ["127.0.0.1", "localhost", "cliproxyapi"]
  }
}
