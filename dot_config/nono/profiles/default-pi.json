{
  "meta": {
    "name": "default-pi",
    "version": "1.0.0",
    "description": "ax-managed Pi coding agent profile"
  },
  "extends": "default-agent",
  "filesystem": {
    "allow": [
      "$HOME/.pi/agent/sessions"
    ],
    "read": [
      {
        "path": "$HOME/.pi/agent",
        "when": "macos"
      },
      {
        "path": "$HOME/.pi/agent/extensions",
        "when": "linux"
      },
      {
        "path": "$HOME/.pi/agent/skills",
        "when": "linux"
      }
    ],
    "read_file": [
      "$HOME/.pi/agent/models.json"
    ],
    "allow_file": [
      "$HOME/.pi/agent/auth.json.lock",
      "$HOME/.pi/agent/models-store.json",
      "$HOME/.pi/agent/models-store.json.lock",
      "$HOME/.pi/agent/settings.json",
      "$HOME/.pi/agent/settings.json.lock"
    ],
    "deny": [
      "$HOME/.pi/agent/auth.json",
      "$HOME/.pi/agent/credentials.json"
    ]
  },
  "platform_overrides": {
    "linux": {
      "security": {
        "capability_elevation": true
      }
    }
  }
}
