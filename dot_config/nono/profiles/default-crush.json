{
  "meta": {
    "name": "default-crush",
    "version": "1.0.0",
    "description": "ax-managed Crush profile"
  },
  "extends": "default-agent",
  "security": {
    "signal_mode": "isolated",
    "capability_elevation": false
  },
  "filesystem": {
    "allow": [
      {
        "path": "$HOME/.local/share/crush",
        "when": "macos"
      },
      {
        "path": "$HOME/.local/share/crush/logs",
        "when": "linux"
      },
      {
        "path": "$HOME/.local/share/crush/sessions",
        "when": "linux"
      },
      "$HOME/.local/state/crush",
      "$HOME/.cache/crush"
    ],
    "read": [
      {
        "path": "$HOME/.config/crush",
        "when": "macos"
      }
    ],
    "read_file": [
      "$HOME/.config/crush/crush.json"
    ],
    "allow_file": [
      "$HOME/.local/share/crush/crush.db",
      "$HOME/.local/share/crush/crush.db-shm",
      "$HOME/.local/share/crush/crush.db-wal"
    ],
    "deny": [
      "$HOME/.config/crush/auth.json",
      "$HOME/.local/share/crush/auth.json",
      "$HOME/.local/share/crush/hyper.json"
    ],
    "suppress_save_prompt": [
      {
        "path": "/proc",
        "when": "linux"
      }
    ]
  },
  "network": {
    "allow_domain": [
      "hyper.charm.land"
    ]
  }
}
