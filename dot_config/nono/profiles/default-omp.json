{
  "meta": {
    "name": "default-omp",
    "version": "1.0.0",
    "description": "Thin ax overlay for the official Oh My Pi nono pack"
  },
  "extends": "nolabs-ai/omp",
  "security": {
    "signal_mode": "isolated",
    "capability_elevation": false
  },
  "groups": {
    "include": [
      "mise_manager",
      "bun_runtime",
      "go_runtime",
      {
        "name": "go_runtime_macos",
        "when": "macos"
      }
    ]
  },
  "filesystem": {
    "allow": [
      "$HOME/.npm/_cacache",
      "$HOME/.npm/_npx",
      "$HOME/.npm/_logs",
      "$HOME/.cache/ax/omp-agent"
    ],
    "read": [
      "$HOME/.config/agents/skills",
      "$HOME/.go",
      "$HOME/.local/state/fnm_multishells",
      "$HOME/.npm-global/bin"
    ],
    "read_file": [
      "$HOME/.config/agents/context/base.md",
      "$HOME/.config/agents/context/environment.md",
      "$HOME/.config/agents/context/ax-context.md",
      "$HOME/.config/ax/omp-models.yml"
    ]
  },
  "network": {
    "block": false,
    "open_port": [8317],
    "no_proxy": ["127.0.0.1", "localhost", "cliproxyapi"]
  }
}
