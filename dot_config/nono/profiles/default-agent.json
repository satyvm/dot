{
  "meta": {
    "name": "default-agent",
    "version": "2.0.0",
    "description": "Shared developer boundary for ax-managed agents without an official nono pack"
  },
  "extends": "default",
  "security": {
    "signal_mode": "isolated",
    "capability_elevation": false
  },
  "groups": {
    "include": [
      "node_runtime",
      "rust_runtime",
      "python_runtime",
      "mise_manager",
      "bun_runtime",
      "go_runtime",
      {
        "name": "go_runtime_macos",
        "when": "macos"
      },
      {
        "name": "user_caches_macos",
        "when": "macos"
      },
      {
        "name": "user_caches_linux",
        "when": "linux"
      },
      {
        "name": "linux_sysfs_read",
        "when": "linux"
      },
      "nix_runtime",
      "git_config",
      "unlink_protection"
    ]
  },
  "filesystem": {
    "allow": [
      "$HOME/.npm/_cacache",
      "$HOME/.npm/_npx",
      "$HOME/.npm/_logs"
    ],
    "read": [
      "$HOME/.agents/skills",
      "$HOME/.config/agents/skills",
      "$HOME/.local/state/fnm_multishells",
      "$HOME/.go"
    ],
    "read_file": [
      "$HOME/.config/agents/universal_context.md"
    ],
    "deny": [
      "$HOME/.ssh",
      "$HOME/.gnupg",
      "$HOME/.aws",
      "$HOME/.cargo/credentials",
      "$HOME/.cargo/credentials.toml",
      "$HOME/.config/gh/hosts.yml",
      "$HOME/.config/cli-proxy-api",
      "$HOME/.cache/zsh/history",
      "$HOME/.zsh_history",
      "$HOME/Library/Keychains",
      "$HOME/Library/Application Support/Google/Chrome",
      "$HOME/Library/Application Support/Chromium",
      "$HOME/Library/Application Support/Firefox"
    ]
  },
  "network": {
    "block": false,
    "network_profile": "developer",
    "open_port": [8317],
    "no_proxy": ["127.0.0.1", "localhost", "cliproxyapi"]
  },
  "workdir": {
    "access": "readwrite"
  }
}
