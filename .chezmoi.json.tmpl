{{- $os := .chezmoi.os -}}
{{- $arch := .chezmoi.arch -}}
{{- if not (has $os (list "darwin" "linux")) -}}
  {{- fail (printf "unsupported operating system %q; this repository supports macOS and Debian/Ubuntu Linux" $os) -}}
{{- end -}}
{{- if not (has $arch (list "amd64" "arm64")) -}}
  {{- fail (printf "unsupported architecture %q; this repository supports amd64 and arm64" $arch) -}}
{{- end -}}

{{- $distro := "macos" -}}
{{- $isWsl := false -}}
{{- if eq $os "linux" -}}
  {{- $distro = "unknown" -}}
  {{- if stat "/etc/os-release" -}}
    {{- $distro = output "sh" "-c" ". /etc/os-release; printf '%s' \"${ID:-unknown}\"" | trim -}}
  {{- end -}}
  {{- if not (has $distro (list "debian" "ubuntu")) -}}
    {{- fail (printf "unsupported Linux distribution %q; only Debian and Ubuntu are supported" $distro) -}}
  {{- end -}}
  {{- if stat "/proc/sys/kernel/osrelease" -}}
    {{- $kernelRelease := output "sh" "-c" "cat /proc/sys/kernel/osrelease 2>/dev/null || true" | lower -}}
    {{- $isWsl = contains "microsoft" $kernelRelease -}}
  {{- end -}}
{{- end -}}

{{- $presetDefault := "server" -}}
{{- if or (eq $os "darwin") $isWsl }}{{ $presetDefault = "workstation" }}{{ end -}}
{{- $preset := promptChoice "Machine preset" (list "minimal" "workstation" "server" "container" "t3") $presetDefault -}}
{{- $customize := promptBool "Customize preset features" false -}}

{{- $setupCli := false -}}
{{- $setupDeveloper := false -}}
{{- $setupAi := false -}}
{{- $aiGateway := "none" -}}
{{- $guiTier := "none" -}}
{{- $setupOs := false -}}
{{- $setupHardening := false -}}
{{- $setupSsh := false -}}
{{- if $customize -}}
  {{- $setupCli = promptBool "Install core CLI setup" true -}}
  {{- if $setupCli }}{{ $setupDeveloper = promptBool "Install developer toolchain" false }}{{ end -}}
  {{- $setupAi = promptBool "Install AI setup" false -}}
  {{- if $setupAi }}{{ $aiGateway = promptChoice "AI gateway for ax" (list "none" "local" "sidecar") "none" }}{{ end -}}
  {{- if eq $os "darwin" }}{{ $guiTier = promptChoice "GUI tools" (list "none" "minimum" "all") "none" }}{{ end -}}
  {{- $setupOs = promptBool "Apply OS customization" false -}}
  {{- if eq $os "linux" }}{{ $setupHardening = promptBool "Configure Linux firewall and fail2ban" false }}{{ end -}}
  {{- $setupSsh = promptBool "Manage SSH signing when the key exists" false -}}
{{- end -}}

{{- $brewPrefix := "/home/linuxbrew/.linuxbrew" -}}
{{- if eq $os "darwin" -}}
  {{- if eq $arch "arm64" }}{{ $brewPrefix = "/opt/homebrew" }}{{ else }}{{ $brewPrefix = "/usr/local" }}{{ end -}}
{{- end -}}
{
  "encryption": "age",
  "age": {
    "identity": "~/.config/chezmoi/key.txt",
    "recipient": "age1naksqkvrfy66sr6ezvw3ykf5ga4tuzp67q78dm94weeduydwssrqx7j67x"
  },
  "data": {
    "machine": {
      "schemaVersion": 1,
      "preset": {{ $preset | quote }},
      "os": {{ $os | quote }},
      "arch": {{ $arch | quote }},
      "distro": {{ $distro | quote }},
      "homebrewPrefix": {{ $brewPrefix | quote }},
      "devRoot": {{ joinPath .chezmoi.homeDir "dev" | quote }},
      "customize": {{ $customize }},
      "overrides": {
        "cli": {{ $setupCli }},
        "developer": {{ $setupDeveloper }},
        "ai": {{ $setupAi }},
        "aiGateway": {{ $aiGateway | quote }},
        "guiTier": {{ $guiTier | quote }},
        "osCustomization": {{ $setupOs }},
        "hardening": {{ $setupHardening }},
        "ssh": {{ $setupSsh }}
      }
    },
    "name": {{ promptString "Git user name" "Satyam" | quote }},
    "email": {{ promptString "Git email address" "75127014+satyvm@users.noreply.github.com" | quote }}
  }
}
