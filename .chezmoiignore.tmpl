{{- $machine := includeTemplate "machine" . | fromJson -}}
# Repo-only files
README.md
LICENSE
AGENTS.md
.setup.sh
.local/CONTEXT.md
.local/adr
.local/handoffs
.local/reports
.backup
examples
tests
.config/agents/skills/add-dotfiles-app/evals

# Existing pre-machine-model configs are a compatibility lane. This prevents
# renamed run_onchange scripts from being treated as new provisioning work on
# an already-configured host. Explicit machine profiles opt into the new,
# convergent provisioning pipeline.
{{- if $machine.legacy }}
install-homebrew-packages.sh
install-system-packages.sh
install-developer-tools.sh
configure-macos-defaults.sh
configure-linux-hardening.sh
setup-shell.sh
setup-ai-agent-platform.sh
.local/bin/dotfiles-macos-apps
.local/bin/dotfiles-macos-cleanup
.local/bin/dotfiles-ssh-enroll
{{- end }}

# Secrets never enter the managed destination when the local age key is absent.
{{- if not (stat (joinPath .chezmoi.homeDir ".config/chezmoi/key.txt")) }}
.backup/cursor-default.code-profile
{{- end }}

{{- if not $machine.predicates.manageShell }}
.zshrc
.zshenv
.dotfiles
.config/nvim
.config/tmux
.config/starship
.config/private_pet
setup-shell.sh
{{- end }}

{{- if or (not $machine.features.developer) (not $machine.predicates.manageHostPackages) }}
install-developer-tools.sh
{{- end }}

{{- if not $machine.predicates.manageHostPackages }}
install-homebrew-packages.sh
{{- end }}
{{- if not $machine.predicates.manageSystemPackages }}
install-system-packages.sh
{{- end }}

{{- if not $machine.features.ai }}
.config/agents
.config/ai-tools
.config/ax
.config/crush
.config/zed
.zed
.config/herdr
.config/nono
.config/opencode
.pi
.local/bin/ax
.local/bin/claude
.local/bin/crush
.local/bin/opencode
.local/bin/pi
setup-ai-agent-platform.sh
{{- end }}
{{- if ne $machine.os "darwin" }}
.zed
{{- end }}
{{- if ne $machine.os "linux" }}
.config/zed
{{- end }}
{{- if not $machine.predicates.manageLocalProxy }}
.config/cli-proxy-api
{{- end }}

{{- if not (or (eq $machine.features.guiTier "minimum") (eq $machine.features.guiTier "all")) }}
.config/ghostty
{{- end }}
{{- if ne $machine.features.guiTier "all" }}
.config/alacritty
{{- end }}

{{- if or (ne $machine.os "darwin") (not $machine.features.osCustomization) }}
configure-macos-defaults.sh
{{- end }}
{{- if or (ne $machine.os "linux") (not $machine.features.hardening) }}
configure-linux-hardening.sh
{{- end }}

{{- if ne $machine.os "darwin" }}
.local/bin/dotfiles-macos-apps
.local/bin/dotfiles-macos-cleanup
{{- end }}
{{- if not $machine.features.ssh }}
.local/bin/dotfiles-ssh-enroll
{{- end }}
